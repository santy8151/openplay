{
  "name": "openplay",
  "version": "0.9.0-beta.1",
  "private": true,
  "description": "OpenPlay — Ecosistema open source (Apache-2.0) modular y federado para juegos Wasm P2P con modding seguro y frontend Cyberpunk",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/client"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm --workspace @openplay/client run dev",
    "preview": "npm --workspace @openplay/client run preview",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
