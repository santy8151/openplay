# OpenPlay Environment Configuration (.env.example)
# Copy to .env before running locally or via Docker Compose. Never commit real secrets.

NODE_ENV=development
OPENPLAY_NODE_NAME="Neo-Bogota Core 01"
OPENPLAY_NODE_URL="http://localhost:8080"
OPENPLAY_GAMES_ORIGIN="http://games.localhost:5173"

# Ed25519 Node Signing Seed (Hex 32 bytes - generate new for production)
OPENPLAY_NODE_SIGNING_KEY_HEX="9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"

# Database & Redis
DATABASE_URL="postgres://openplay:openplay_dev_pass@localhost:5432/openplay?sslmode=disable"
REDIS_URL="redis://localhost:6379/0"

# CoTURN Ephemeral Credentials (HMAC-SHA1 REST API)
TURN_URLS="turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp"
TURN_SHARED_SECRET="openplay_coturn_hmac_shared_secret_change_me"
TURN_CREDENTIAL_TTL_SECONDS=3600

# Guest JWT Auth (EdDSA)
JWT_ISSUER="openplay-node"
JWT_GUEST_TTL_MINUTES=120

# Federation Peers (comma-separated URLs)
FEDERATION_PEERS="http://node-b:8081"

# Privacy & Network Defaults
DEFAULT_RELAY_ONLY="false"
TELEMETRY_OPT_IN_DEFAULT="false"
MAX_PACKAGE_SIZE_BYTES=20971520
